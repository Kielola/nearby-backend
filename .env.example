PORT=3000

# Set to "production" on your host. Required for the CORS guard above.
NODE_ENV=production

# Postgres connection string — we'll fill this in step 2 when we set up
# the database and Drizzle.
DATABASE_URL=postgres://user:password@localhost:5432/nearby

# Firebase Admin credentials — used server-side to verify tokens issued
# by Firebase Auth on the client. Filled in step 4.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# OPTIONAL. Without it the backend uses an in-memory presence store:
# online/offline works, but resets on restart and will NOT work across
# multiple instances. Leave blank to remove Redis from your deployment
# entirely while testing on a single free instance.
REDIS_URL=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Comma-separated list of allowed frontend origins for CORS and sockets.
# REQUIRED in production — the server refuses to start without it rather
# than silently defaulting to "allow any origin with credentials".
FRONTEND_URL=https://yourdomain.com,https://www.yourdomain.com

# Optional — leave blank locally, set in production for error tracking.
SENTRY_DSN=
