PORT=3000

# Postgres connection string — we'll fill this in step 2 when we set up
# the database and Drizzle.
DATABASE_URL=postgres://user:password@localhost:5432/nearby

# Firebase Admin credentials — used server-side to verify tokens issued
# by Firebase Auth on the client. Filled in step 4.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

REDIS_URL=redis://localhost:6379

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Comma-separated list of allowed frontend origins for CORS.
FRONTEND_URL=

# Optional — leave blank locally, set in production for error tracking.
SENTRY_DSN=
