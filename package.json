{
  "name": "nearby-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Nearby app backend — NestJS + Postgres + Drizzle",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand --forceExit --detectOpenHandles"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.36.4",
    "firebase-admin": "^13.0.2",
    "postgres": "^3.4.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1",
    "ioredis": "^5.4.2",
    "bullmq": "^5.34.5",
    "socket.io": "^4.8.1",
    "@nestjs/websockets": "^10.4.15",
    "@nestjs/platform-socket.io": "^10.4.15",
    "cloudinary": "^2.5.1",
    "@nestjs/throttler": "^6.3.0",
    "@nestjs/swagger": "^8.1.0",
    "@sentry/node": "^8.47.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "@nestjs/testing": "^10.4.15",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "supertest": "^7.0.0",
    "@types/jest": "^29.5.14",
    "@types/supertest": "^6.0.2"
  }
}
